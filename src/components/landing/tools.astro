---
import { Command } from "../command";
import { Tool } from "../tool";
---

<section id="tools" class="flex flex-col p-5">
    <div class="flex flex-col">
        <Command cmd="ls ~/tools" />
        <!-- <h1 class="mb-2 text-4xl font-bold"> -->
        <!--     Tools<span class="blink">_</span> -->
        <!-- </h1> -->
        <!-- <p class="text-muted-foreground mb-5">Tools Used</p> -->
        <div class="grid grid-cols-4 gap-1">
            <Tool url="https://git-scm.com" text="git" />
            <Tool url="https://neovim.io" text="neovim" />
            <Tool url="https://code.visualstudio.com" text="vscode" />
            <Tool url="https://expressjs.com" text="express.js" />
            <Tool url="https://tailwindcss.com" text="tailwindcss" />
            <Tool url="https://react.dev" text="react.js" />
            <Tool url="https://nextjs.org" text="next.js" />
        </div>
    </div>
</section>
