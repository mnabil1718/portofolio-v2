---
import { Command } from "../command";
import { Ascii } from "../ascii";
import { Link } from "../link";

const links = [
    {
        id: 1,
        href: "mailto:mnabil1718@gmail.com",
        label: "email",
    },
    {
        id: 2,
        href: "/documents/resume 2026.pdf",
        label: "resume",
    },
    {
        id: 3,
        href: "https://github.com/mnabil1718",
        label: "github",
    },
];
---

<section
    id="hero"
    class="flex min-h-[70svh] flex-col items-center justify-center px-5 py-10"
>
    <div class="flex max-w-md flex-col">
        <Ascii client:load />
        <Command cmd="whoami" />
        <h1 class="mb-2 text-xl font-bold md:text-3xl">
            Muhammad Nabil<span class="blink">_</span>
        </h1>
        <p class="text-muted-foreground mb-5">Fullstack Developer</p>
        <p class="mb-5 text-justify text-sm md:text-base">
            A full-stack developer who is passionate about computers and how
            they work. Worked with various web technologies and recently piqued
            interest in more low-level stuff. I also use Neovim btw.
        </p>
        <div class="flex items-center gap-4">
            {
                links.map((l) => (
                    <Link label={l.label} href={l.href} client:load />
                ))
            }
        </div>
    </div>
</section>
