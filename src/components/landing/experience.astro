---
import Image from "astro/components/Image.astro";
import { Command } from "../command";

import Zafira from "../../assets/zafiraglow.png";
---

<section id="tools" class="flex flex-col border-t p-5">
    <div class="flex flex-col">
        <Command cmd="cat ./experiences.log" />
        <h1 class="mb-5 text-xl font-bold">Experiences</h1>
        <ul class="flex items-stretch">
            <div class="text-muted-foreground pr-2 text-xs">
                Jan 2025 - Aug 2025
            </div>
            <div class="bg-foreground h-28 w-1 flex-none"></div>
            <div class="pl-3">
                <div class="flex items-start gap-5">
                    <div class="relative h-14 w-14 overflow-hidden">
                        <Image
                            src={Zafira}
                            alt="Zafira Glow"
                            width={56}
                            height={56}
                        />
                    </div>
                    <div>
                        <h2>Zafira Glow</h2>
                        <p class="text-muted-foreground mb-3 text-xs">
                            Freelance Digital Marketer
                        </p>
                        <ul
                            class="text-muted-foreground flex list-inside list-disc flex-col gap-2 text-sm"
                        >
                            <li>Develop e-commerce site using wordpress</li>
                            <li>
                                Improve site performance & SEO best practices
                            </li>
                            <li>
                                Develop digital marketing & content marketing
                                strategies
                            </li>
                            <li>
                                Implement marketing strategies using Meta Ads &
                                Google Ads
                            </li>
                        </ul>
                    </div>
                </div>
                <ul></ul>
            </div>
        </ul>
    </div>
</section>
