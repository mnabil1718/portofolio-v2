---
import { Command } from "../command";
import ExperienceItem from "../experience-item.astro";
import { getCollection } from "astro:content";

const experiences = (await getCollection("experiences")).sort(
    (a, b) => b.data.from.getTime() - a.data.from.getTime(),
);
---

<section id="experience" class="flex flex-col border-t px-5 py-10">
    <div class="flex flex-col">
        <Command cmd="cat ./experiences.log" />
        <h2 class="mb-10 text-xl font-bold">Experiences</h2>
        <ul class="flex flex-col gap-0">
            {experiences.map((exp) => <ExperienceItem exp={exp.data} />)}
        </ul>
    </div>
</section>
