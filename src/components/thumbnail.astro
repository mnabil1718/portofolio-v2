---
import { Image } from "astro:assets";

interface Props {
    src: any;
    alt: string;
    className?: string;
}

const { src, alt, className = "" } = Astro.props;
---

<div
    class:list={[
        "bg-muted relative mb-7 flex aspect-video justify-center overflow-hidden",
        className,
    ]}
>
    <Image src={src} alt={alt} class="h-full w-auto object-contain" />
</div>
