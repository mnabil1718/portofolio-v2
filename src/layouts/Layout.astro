---
import { Font } from "astro:assets";
import { Navbar } from "@/components/navbar";
import { Footer } from "../components/footer";

interface Props {
    title: string;
    description: string;
}

const {
    title = "Muhammad Nabil - Full Stack Developer",
    description = "Full stack developer with over 2 years of experience. Focused on systems reliability & performance. Proficient in Go, TypeScript, PostgreSQL, and Next.js",
} = Astro.props;
---

<script is:inline>
    const getThemePreference = () => {
        if (
            typeof localStorage !== "undefined" &&
            localStorage.getItem("theme")
        ) {
            return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    };
    const isDark = getThemePreference() === "dark";
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");

    if (typeof localStorage !== "undefined") {
        const observer = new MutationObserver(() => {
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <Font cssVariable="--font-mono" preload />
    </head>
    <body>
        <main class="relative mx-auto min-h-screen max-w-4xl md:border-x">
            <Navbar client:load />
            <slot />
            <Footer client:load />
        </main>
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        font-family: var(--font-mono);
    }
</style>
