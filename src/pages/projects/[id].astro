---
import "../../styles/global.css";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Prose from "@/components/prose.astro";
import TerminalSeparator from "@/components/terminal-separator.astro";
import { getCollection, render } from "astro:content";
import { Link } from "@/components/link";
export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((p) => ({
        params: { id: p.id },
        props: { project: p },
    }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={project.data.title} description={project.data.desc}>
    <article class="mx-auto px-5 py-10">

            <nav class="flex items-center text-xs justify-between mb-7">
                <Link
                    label="Go to projects"
                    href="/projects"
                    newTab={false}
                    client:load
                />

            <span class="text-muted-foreground">
                {
                    project.data.created_at.toLocaleDateString("en-UK", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                    })
                }
            </span>
            </nav>
        <header class="mb-7">

<Image
    src={project.data.image}
    alt={project.data.title}
    class="mb-10"
/>
            <h1 class="mb-5 text-xl font-bold md:text-3xl">
                {project.data.title}<span class="blink">_</span>
            </h1>

            <p class="text-foreground dark:text-foreground/70 mb-5">
                {project.data.desc}
            </p>

            <div class="flex items-center gap-3">
                {
                    project.data.live_url && (
                        <Link
                            label="View demo"
                            href={project.data.live_url}
                            client:load
                        />
                    )
                }
                {
                    project.data.github_url && (
                        <Link
                            label="View github"
                            href={project.data.github_url}
                            client:load
                        />
                    )
                }
            </div>
        </header>

        <TerminalSeparator />

        <div class="mt-7">
            <Prose>
            <Content />
            </Prose>
        </div>
    </article>
</Layout>
